{
  "name": "tarnished-tune-4r",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "An original controller-first soulslike vertical slice built on my-3dge.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 43187 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 43187 --strictPort",
    "test": "node --test tests/*.test.js",
    "test:browser": "node scripts/browser-check.mjs",
    "verify": "npm test && npm run build",
    "demo:prove": "node scripts/prove-demo.mjs",
    "check:engine": "node scripts/check-engine.mjs",
    "format": "prettier --write src tests scripts index.html *.json *.md docs .github vite.config.js",
    "format:check": "prettier --check src tests scripts index.html *.json *.md docs .github vite.config.js"
  },
  "dependencies": {
    "@dimforge/rapier3d-simd-compat": "0.21.0",
    "three": "0.182.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "prettier": "3.9.10",
    "vite": "7.3.7"
  }
}
